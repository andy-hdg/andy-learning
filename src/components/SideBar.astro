---
import Icon from './Icon.astro';
import { localizePath, t, UI, withBase, type Lang } from '../lib/i18n';
import { PROFILE } from '../data/profile';

export type NavId = 'home' | 'learning' | 'certificates' | 'skills' | 'about';

interface Props {
  lang: Lang;
  active?: NavId;
  alternates: { vi: string; en: string };
}

const { lang, active, alternates } = Astro.props;
const ui = UI[lang];
const items: { id: NavId; path: string }[] = [
  { id: 'home', path: '/' },
  { id: 'learning', path: '/learning/' },
  { id: 'certificates', path: '/certificates/' },
  { id: 'skills', path: '/skills/' },
  { id: 'about', path: '/about/' },
];
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay" aria-label="Close menu"></label>
  <aside class="px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col">
    <div class="w-fit mx-auto mt-5 mb-3 text-center">
      <a href={localizePath(lang, '/')}>
        <div class="avatar transition ease-in-out hover:scale-[102%] block m-auto">
          <div class="w-[8.5rem] mask mask-circle">
            <img src={withBase('/profile.svg')} alt={PROFILE.name} width="300" height="300" />
          </div>
        </div>
      </a>
      <div class="mt-3 font-bold text-lg">{PROFILE.name}</div>
      <div class="text-sm opacity-70">{t(PROFILE.headline, lang)}</div>
    </div>

    <ul class="menu grow shrink menu-md w-full overflow-y-auto">
      {
        items.map((item) => (
          <li>
            <a
              class="py-3 text-base"
              href={localizePath(lang, item.path)}
              aria-current={item.id === active ? 'page' : undefined}
            >
              {ui.nav[item.id]}
            </a>
          </li>
        ))
      }
    </ul>

    <div
      class="block sticky pointer-events-none bottom-24 bg-base-200 h-12 [mask-image:linear-gradient(transparent,#000000)]"
    >
    </div>
    <div class="sticky bottom-0 bg-base-200 pb-5 pt-1 flex flex-col items-center gap-3">
      <div class="join" role="group" aria-label={ui.language}>
        <a
          href={alternates.vi}
          hreflang="vi"
          lang="vi"
          class:list={['btn btn-sm join-item', lang === 'vi' ? 'btn-neutral' : 'btn-ghost']}
          aria-current={lang === 'vi' ? 'true' : undefined}>Tiếng Việt</a
        >
        <a
          href={alternates.en}
          hreflang="en"
          lang="en"
          class:list={['btn btn-sm join-item', lang === 'en' ? 'btn-neutral' : 'btn-ghost']}
          aria-current={lang === 'en' ? 'true' : undefined}>English</a
        >
      </div>
      <div class="flex justify-center gap-6">
        {
          PROFILE.links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" aria-label={link.label} title={link.label}>
              <Icon name={link.icon} class="w-6 h-6" />
            </a>
          ))
        }
      </div>
    </div>
  </aside>
</div>
