---
interface Props {
  href?: string;
  linkLabel?: string;
}
const { href, linkLabel } = Astro.props;
---

<div class="flex flex-wrap items-baseline justify-between gap-2 mb-3 mt-12">
  <h2 class="text-3xl font-bold"><slot /></h2>
  {href && <a href={href} class="link link-hover text-sm">{linkLabel} →</a>}
</div>
