---
import { getCollection } from 'astro:content';
import CertificateDetailView from '../../../views/CertificateDetailView.astro';

export async function getStaticPaths() {
  const entries = await getCollection('certificates');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<CertificateDetailView lang="en" entry={entry} />
