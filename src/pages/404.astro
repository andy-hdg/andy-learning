---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, UI } from '../lib/i18n';
---

<BaseLayout lang="vi" path="/" title="404" includeSidebar={false}>
  <div class="text-center py-10">
    <h1 class="text-9xl font-bold mb-4">404</h1>
    <p class="text-2xl">{UI.vi.notFound}</p>
    <p class="text-lg opacity-70" lang="en">{UI.en.notFound}</p>
    <div class="flex justify-center gap-4 mt-9">
      <a class="btn" href={localizePath('vi', '/')}>{UI.vi.nav.home}</a>
      <a class="btn btn-outline" href={localizePath('en', '/')} lang="en">{UI.en.nav.home}</a>
    </div>
  </div>
</BaseLayout>
